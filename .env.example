# Free Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hard cap on Gemini HTTP calls this process will make per hour. 0 = never call Gemini.
GEMINI_MAX_CALLS_PER_HOUR=8

# Extra Gemini call to rewrite the recruiter note. Leave off — TypeScript already writes it.
GEMINI_NARRATIVE=0
